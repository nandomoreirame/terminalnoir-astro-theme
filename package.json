{
  "name": "terminalnoir-astro-theme",
  "private": true,
  "type": "module",
  "description": "A static Astro starter for developer tools, with Noir and Paper modes.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "test:contracts": "node --test tests/ci.test.mjs tests/adoption.test.mjs tests/browser-matrix.test.mjs",
    "verify:imports": "node --test tests/verify-imports.test.mjs",
    "verify:matrix": "node scripts/verify-matrix.mjs",
    "verify": "npm run test:contracts && npm test && npm run check && npm run format:check && npm run verify:imports && npm run verify:matrix"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@iconify-json/lucide": "1.2.141",
    "@iconify-json/simple-icons": "1.2.99",
    "astro": "7.4.1",
    "astro-icon": "1.2.0",
    "marked": "18.1.0",
    "sanitize-html": "^2.18.1",
    "shiki": "4.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "es-module-lexer": "^3.0.4",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "version": "0.0.1"
}
